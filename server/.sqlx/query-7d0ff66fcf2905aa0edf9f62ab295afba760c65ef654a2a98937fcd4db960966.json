  "query": "\n        SELECT t.id, t.slug, p.seq\n        FROM posts p JOIN threads t ON t.id = p.thread_id\n        WHERE p.id = $1 AND t.deleted_at IS NULL AND thread_readable(t.visibility, t.category_id, $2, $3)\n        ",
