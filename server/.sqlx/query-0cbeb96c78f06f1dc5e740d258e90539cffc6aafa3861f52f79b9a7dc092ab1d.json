{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.title, c.name AS \"space_name?\", c.slug AS \"space_slug?\",\n                  d.id AS \"merged_id?\", d.title AS \"merged_title?\"\n           FROM threads t\n           JOIN spaces c ON c.id = t.space_id\n           LEFT JOIN threads d ON d.id = t.merged_into_thread_id\n           WHERE t.id = $1 AND t.deleted_at IS NOT NULL\n             AND thread_readable(t, $2, $3, $4, $5)",
