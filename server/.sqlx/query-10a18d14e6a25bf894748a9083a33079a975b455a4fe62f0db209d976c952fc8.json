{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, p.seq, p.created_at, p.edited_at, p.thread_id,\n               (p.deleted_at IS NULL AND p.hidden_at IS NULL AND t.deleted_at IS NULL\n                AND thread_readable(t, $2, $3, $4, $5)) AS \"available!\"\n        FROM posts p\n        JOIN threads t ON t.id = p.thread_id\n        WHERE p.id = $1\n        ",
