  "query": "SELECT p.id, p.author_id, p.created_at, t.visibility\n               FROM posts p JOIN threads t ON t.id = p.thread_id\n               WHERE p.deleted_at IS NULL AND p.hidden_at IS NULL AND p.id IS DISTINCT FROM $1\n               ORDER BY p.id",
