  "query": "SELECT c.slug, c.name,\n                  bool_or(cg.access = 'read') AS \"read!\", bool_or(cg.access = 'write') AS \"write!\"\n           FROM category_groups cg JOIN categories c ON c.id = cg.category_id\n           WHERE cg.group_id = $1\n           GROUP BY c.id\n           ORDER BY c.position, c.id",
