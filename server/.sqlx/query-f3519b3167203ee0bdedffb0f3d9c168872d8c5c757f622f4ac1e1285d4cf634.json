  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.title, t.slug, t.locked, t.last_seq, t.category_id AS \"category_id!\"\n        FROM threads t\n        WHERE t.id = $1 AND t.deleted_at IS NULL AND t.category_id IS NOT NULL\n          AND thread_readable(t.visibility, t.category_id, $2, $3)\n        ",
