{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.rev, r.created_at, CASE WHEN r.redacted_at IS NULL THEN r.body_md END AS body_md,\n               u.id AS editor_id, u.username, u.display_name\n        FROM post_revisions r JOIN users u ON u.id = r.editor_id\n        WHERE r.post_id = $1\n        ORDER BY r.rev\n        ",
