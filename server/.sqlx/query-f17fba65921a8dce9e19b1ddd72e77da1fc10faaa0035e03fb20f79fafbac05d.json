{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.author_id FROM posts p JOIN thread_reads r ON r.thread_id = p.thread_id\n               WHERE p.thread_id = $1 AND r.user_id = $2 AND p.seq > r.last_read_seq\n                 AND p.author_id <> $2 AND p.deleted_at IS NULL AND p.hidden_at IS NULL\n               ORDER BY p.seq",
