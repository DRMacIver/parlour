{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.slug, t.space_id AS \"space_id!\",\n               thread_readable(t, $2, $3, $4, $5) AS \"readable!\"\n        FROM threads t\n        WHERE t.id = $1 AND t.deleted_at IS NULL AND t.space_id IS NOT NULL\n          AND (thread_readable(t, $2, $3, $4, $5) OR thread_granted(t, $6, $7))\n        ",
