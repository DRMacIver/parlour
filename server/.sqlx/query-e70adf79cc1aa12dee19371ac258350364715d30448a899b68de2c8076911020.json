  "query": "\n        SELECT t.id, t.title, t.slug, t.locked, t.last_seq, t.category_id\n        FROM threads t\n        WHERE t.id = $1 AND t.deleted_at IS NULL\n          AND (thread_readable(t.visibility, t.category_id, $2, $3) OR dm_readable(t.id, t.visibility, $4))\n        ",
