  "db_name": "PostgreSQL",
  "query": "SELECT u.id, u.username AS \"username: String\", u.display_name, u.role, u.created_at,\n                  i.username AS \"inviter?: String\"\n           FROM users u LEFT JOIN users i ON i.id = u.invited_by_user_id\n           WHERE u.deleted_at IS NULL\n           ORDER BY u.username\n           LIMIT $1 OFFSET $2",
