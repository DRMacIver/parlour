# Copy to .env and fill in. See docs/admin-guide.md.

# The forum's domain name, which must point at this server. Caddy fetches
# its HTTPS certificate.
PARLOUR_DOMAIN=forum.example.com

# The database password: long and random, for example from
#   openssl rand -hex 32
# Parlour's connection is made from it; nothing else needs it.
POSTGRES_PASSWORD=

# An SMTP relay for email (sign-up links, notifications). These can also
# be set, and tested, in the admin settings after setup.
PARLOUR_SMTP_HOST=
PARLOUR_SMTP_PORT=587
# none, starttls or tls
PARLOUR_SMTP_SECURITY=starttls
PARLOUR_SMTP_USERNAME=
PARLOUR_SMTP_PASSWORD=
PARLOUR_MAIL_FROM=Our Forum <forum@forum.example.com>

# Backups: when the nightly one runs (UTC, HH:MM), how many days of them to
# keep, and how many of the dumps taken before each start.
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_PRE_MIGRATION=5
